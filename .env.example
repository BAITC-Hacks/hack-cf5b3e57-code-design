# ToiMatch — переменные для `docker compose up --build` (читаются из файла .env в корне).
# Скопируйте: cp .env.example .env — и при необходимости впишите ключ.
# Без ключа всё работает в демо-режиме MOCK=1. Не коммитьте .env с настоящим ключом.

# 1 — демо-режим без модели (по умолчанию); 0 — живые объяснения и чат через OpenAI (нужен ключ)
MOCK=1

# Необязательно: ключ OpenAI для живых объяснений и чата (используется только при MOCK=0)
OPENAI_API_KEY=

# Модель OpenAI для объяснений и чата
MODEL_MAIN=gpt-4o-mini

# Адрес сайта, которому API разрешает запросы из браузера (CORS)
CORS_ORIGIN=http://localhost:3000

# Адрес API для браузера (пошаговый стрим на /manager)
NEXT_PUBLIC_API_URL=http://localhost:3001
