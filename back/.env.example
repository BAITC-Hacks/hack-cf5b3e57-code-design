# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hackaton?schema=public"

# Nest app port
PORT=3001

# Force the offline demo mode, even if an OpenAI key is set.
MOCK=1

# Optional OpenAI key for live explanations and chat. Keep MOCK=1 for offline demo.
OPENAI_API_KEY=

# OpenAI model for explanations and chat.
MODEL_MAIN=gpt-4o-mini
