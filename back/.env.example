# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hackaton?schema=public"

# Nest app port
PORT=3001

# OpenAI API key — used for /match explanations and the chat assistant.
# Empty = MOCK mode: deterministic template answers, works without network.
OPENAI_API_KEY=

# OpenAI chat model. gpt-4o-mini is cheap enough for tool-calling chat + explanations.
MODEL_MAIN=gpt-4o-mini
