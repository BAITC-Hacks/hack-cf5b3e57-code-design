generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

/// Учетная запись приложения. Роль проверяется на сервере при каждом admin-запросе.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

/// Профиль подрядчика event-площадки. Схема повторяет колонки датасета организаторов.
model Contractor {
  id           String   @id
  anonName     String
  categories   String[]
  city         String
  cityImputed  Boolean  @default(false)
  synthetic    Boolean  @default(false)
  priceFromKzt Int
  priceImputed Boolean  @default(false)
  eventFormats String[]
  languages    String[]
  maxHours     Int?
  busyDates    String[]
  description  String
  isActive     Boolean  @default(true)

  enrichment Enrichment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([isActive])
  @@map("contractors")
}

/// Офлайн-обогащение: агент один раз проходит по каждому описанию и достаёт
/// специализацию и проверяемые признаки. Используется на этапе объяснения.
model Enrichment {
  contractorId   String     @id
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  specialization String
  signals        String[]
  raw            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enrichments")
}

/// Кэш объяснений LLM. Ключ — хэш нормализованного запроса + id подрядчика + locale.
/// Обеспечивает детерминизм: тот же запрос → тот же текст.
model ExplanationCache {
  id           String @id @default(cuid())
  requestHash  String
  contractorId String
  locale       String @default("ru")
  reason       String
  factsUsed    Json
  version      Int    @default(1)

  createdAt DateTime @default(now())

  @@unique([requestHash, contractorId, locale])
  @@index([requestHash])
  @@map("explanation_cache")
}

/// Диалоговая сессия ассистента. Хранит режим (search/bundle), язык
/// и всю историю сообщений — чтобы клиент мог перезайти и продолжить.
model ChatSession {
  id        String   @id @default(cuid())
  mode      String
  locale    String   @default("ru")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@map("chat_sessions")
}

/// Одно сообщение. `role`: 'user' | 'assistant'. `attachments` хранит
/// прикреплённые результаты tool-вызовов (MatchResponse / EventBundle) как JSON.
model ChatMessage {
  id          String      @id @default(cuid())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String
  content     String
  attachments Json?
  /// Токены OpenAI, потраченные на это сообщение (для метрик и оптимизации).
  tokensIn    Int?
  tokensOut   Int?

  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
