# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hackaton?schema=public"

# Nest app port
PORT=3001

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN="http://localhost:3000"

# Required in production (32+ characters). Development generates an ephemeral
# process-local secret when omitted; restarting invalidates existing sessions.
SESSION_SECRET="replace-with-at-least-32-random-characters"
SESSION_TTL_SECONDS=3600

# Optional development seed overrides. Production seed requires both values.
# Development defaults: admin@hackalem.local / HackAlem2026!
# Never use those demo credentials in production or commit real values.
ADMIN_EMAIL="admin@hackalem.local"
ADMIN_PASSWORD="HackAlem2026!"

# NVIDIA NIM API key — LLM & embeddings. Empty = MOCK mode (no external calls)
NVIDIA_API_KEY=

# OpenAI API key — used for /match explanations and the chat assistant.
# Empty = MOCK mode: deterministic template answers, works without network.
OPENAI_API_KEY=

# OpenAI chat model. gpt-4o-mini is cheap enough for tool-calling chat + explanations.
MODEL_MAIN=gpt-4o-mini
